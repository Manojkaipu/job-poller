# Copy to .env (gitignored) and fill in. Without SMTP_USER and SMTP_PASSWORD the poller only prints.

# SMTP_USER=you@gmail.com

# Gmail: an app password (Google Account > Security > 2-Step Verification > App passwords),
# not your normal password. 16 letters; spaces don't matter.
# SMTP_PASSWORD=abcdabcdabcdabcd

# Optional, comma-separated; defaults to SMTP_USER.
# MAIL_TO=you@gmail.com

# Only for providers other than Gmail. Port 587 uses STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
